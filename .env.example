# --- Server ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
SHUTDOWN_TIMEOUT_MS=15000
# Behind a reverse proxy: Express "trust proxy" (e.g. 1 or loopback) so IP allowlists see client IPs
TRUST_PROXY=

# --- Logging ---
LOG_LEVEL=info
# Human-readable logs (default: true outside production, JSON lines in production)
LOG_PRETTY=
BAILEYS_LOG_LEVEL=error

# --- Security ---
# Required when NODE_ENV=production (min. 16 characters). Send it in the x-api-key header.
API_KEY=change-me-to-a-long-random-string
# Lifetime of signed QR page links returned by POST /api/sessions/init and /:sessionId/qr-link
QR_LINK_TTL_SECONDS=600
# Allow media/webhook URLs that resolve to private or local addresses (e.g. an n8n container on the same network)
ALLOW_PRIVATE_URLS=false
# Max size of media downloaded from imageUrl/attachmentUrl (bytes)
MEDIA_MAX_BYTES=52428800

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=whatsapp_gateway
DB_SSL=false

# --- WhatsApp ---
# Country code that replaces the leading 0 of local numbers (08123... -> 628123...)
DEFAULT_COUNTRY_CODE=62
# Optional WA Web version override, only when WhatsApp rejects the bundled one (disconnect code 405)
WA_VERSION=
# Reconnect backoff for paired sessions (exponential with jitter)
RECONNECT_BASE_DELAY_MS=2000
RECONNECT_MAX_DELAY_MS=300000
# Delay between sessions restored at startup
RESTORE_STAGGER_MS=1500

# --- Webhook ---
GLOBAL_WEBHOOK_URL=
# HMAC secret for X-Webhook-Signature (min. 16 characters); per-session secrets override it
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=10
WEBHOOK_RETRY_BASE_DELAY_MS=10000
WEBHOOK_RETRY_MAX_DELAY_MS=3600000
WEBHOOK_RETENTION_DAYS=7
WEBHOOK_FAILED_RETENTION_DAYS=30

# --- Outbound queue ---
# Random gap between two messages of the same session
SEND_INTERVAL_MIN_MS=2000
SEND_INTERVAL_MAX_MS=6000
# How long a send request waits for the result before answering 202 (still queued)
SEND_WAIT_TIMEOUT_MS=60000
QUEUE_MAX_ATTEMPTS=3
QUEUE_RETRY_DELAY_MS=30000
QUEUE_MAX_AGE_HOURS=24
QUEUE_POLL_MS=1000

# --- Bulk sending, number validation, groups ---
BULK_MAX_TARGETS=500
VALIDATE_MAX_NUMBERS=50
VALIDATE_MIN_INTERVAL_MS=3000
VALIDATE_CACHE_DAYS=7
# Uncached number lookups per session per rolling 24 hours (validate + new-chat checks)
VALIDATE_DAILY_LIMIT=200
GROUPS_CACHE_MINUTES=10

# --- Anti-Ban Guard (see README, "Anti-Ban Guard") ---
# New chats = messages to people who never wrote to the number
NEW_CONTACT_DAILY_LIMIT=20
NEW_CONTACT_INTERVAL_MIN_MS=60000
NEW_CONTACT_INTERVAL_MAX_MS=180000
# A freshly paired number only replies and writes to known contacts for this long
NEW_SESSION_COOLDOWN_HOURS=72
RECONNECT_WARMUP_MS=120000
# New-chat pause after error 463 when WhatsApp reports no timelock
RESTRICTION_PAUSE_HOURS=24
# Campaigns (bulk sends): hours, time zone, one per recipient per cool-down, consent required
CAMPAIGN_HOURS=08:00-20:00
CAMPAIGN_TIMEZONE=Asia/Jakarta
CAMPAIGN_RECIPIENT_COOLDOWN_HOURS=72
CAMPAIGN_REQUIRE_CONSENT=true
OPT_OUT_KEYWORDS=STOP,BERHENTI,UNSUBSCRIBE,UNSUB,STOP PROMO,BERHENTI PROMO
OPT_IN_KEYWORDS=START,SUBSCRIBE,LANGGANAN
VALIDATE_NEW_CONTACTS=true
# Health monitor: pauses campaigns when delivery or reply rates drop
CAP_POLL_HOURS=6
HEALTH_CHECK_INTERVAL_MS=600000
HEALTH_MIN_SAMPLE=20
HEALTH_MIN_DELIVERY_RATE=0.6
HEALTH_MIN_REPLY_RATE=0.05
HEALTH_PAUSE_HOURS=24

# --- Typing simulation ---
MIN_TYPING_DELAY_MS=1200
MAX_TYPING_DELAY_MS=3000
# Upper bound for the per-request delayMs field
MAX_REQUEST_DELAY_MS=15000
AUTO_READ_MESSAGES=false
